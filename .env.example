# ---- PUBLIC (embedded in the browser bundle; safe to expose) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key from `supabase status`>   # teacher client; RLS protects data
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA           # Cloudflare test key (always passes)

# ---- SECRET (Cloudflare Pages Functions only: .dev.vars locally, `wrangler pages secret put` in cloud) ----
# NEVER prefix with VITE_, NEVER commit. See .dev.vars.example
