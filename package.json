{
  "name": "lun-thai-lek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:dev": "pnpm build && wrangler pages dev dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.functions.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --require ./scripts/node20-polyfills.cjs ./node_modules/vitest/vitest.mjs run",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "test:int": "node --require ./scripts/node20-polyfills.cjs ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "seed:demo": "node scripts/demo-seed.mjs",
    "test:e2e": "pnpm build && playwright test",
    "lighthouse": "lhci collect && lhci assert"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@eslint/js": "^9",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.168.0"
  }
}
