{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8788/submit",
        "http://127.0.0.1:8788/score"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "pessimistic"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "pessimistic"
          }
        ]
      }
    }
  }
}
